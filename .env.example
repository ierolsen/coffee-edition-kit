# coffee-edition secrets for the Pico. Copy this file to .env, fill it in, then copy .env to
# the Pico next to config.py:
#   mpremote cp .env :
# .env is in .gitignore and must never be committed. Never paste the token into a chat.
WIFI_SSID="your-2.4-GHz-network"
WIFI_PASSWORD="your-wifi-password"
# A fine-grained token for this repository only: Contents read-only, Actions read and write.
# docs/pico.md, "The GitHub token", shows how to make one.
GITHUB_TOKEN=""
